{
  "openapi": "3.0.0",
  "info": {
    "title": "ChatBit API Documentation",
    "version": "1.0.0",
    "description": "REST API documentation for ChatBit real-time support chat system."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "fullname", "passwordHash", "role"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "fullname": { "type": "string" },
                  "passwordHash": { "type": "string", "description": "Raw password" },
                  "role": { "type": "string", "enum": ["CLIENT", "AGENT"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Registered successfully" },
          "400": { "description": "Invalid parameters or user already exists" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Log in an existing user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "passwordHash"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "passwordHash": { "type": "string", "description": "Raw password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged in successfully" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Success" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/conversations": {
      "get": {
        "summary": "List conversations",
        "description": "Clients see their own conversations. Agents see open/pending ones.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Success" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create a new conversation (Client only)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["subject"],
                "properties": {
                  "subject": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created successfully" },
          "403": { "description": "Forbidden (Agents cannot create)" }
        }
      }
    },
    "/conversations/{id}/messages": {
      "get": {
        "summary": "Get conversation messages (Paginated)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": { "description": "Success" },
          "403": { "description": "Forbidden if not a participant" }
        }
      }
    },
    "/conversations/{id}/close": {
      "patch": {
        "summary": "Close a conversation (Agent only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Closed successfully" },
          "403": { "description": "Forbidden if not an Agent" }
        }
      }
    }
  }
}
